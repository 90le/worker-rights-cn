  "source_note": "与 layoff-defense/references/legal-map.md 配合使用；发送协商表述前，应结合案件事实、当地实务和已经签署的文件复核。",
  "global_safety_rules": [
    "不要威胁、侮辱、骚扰或暗示实施违法报复。",
    "不要捏造事实、伪造证据、篡改截图或倒签文件。",
    "不要复制公司秘密、源代码、客户名单或与争议无关的个人信息。",
    "将投诉、仲裁或执行表述为依法可选择的途径，不要用作恐吓。",
    "将已经确认的事实与请求对方说明的事项明确区分。"
  ],
  "message_blocks": {
    "request_written_terms": {
      "purpose": "请人力资源部门书面提供方案、理由、金额、付款日期、解除或终止证明表述和协议草稿。",
      "source_anchors": [
        "LDA-2007#art4",
        "LDA-2007#art6"
      ]
    },
    "counteroffer_amount_basis": {
      "purpose": "以工作年限、解除或终止前 12 个月工资基数、法定项目及欠付金额明细作为还价依据。",
      "source_anchors": [
        "LCL-2012#art46",
        "LCL-2012#art47",
        "LCL-REG-2008#art27"
      ]
    },
    "rights_reservation": {
      "purpose": "协商期间明确保留相关权利，不作缺乏依据的指控。",
      "source_anchors": [
        "LDA-2007#art5",
        "LDA-2007#art27"
      ]
    },
    "factual_refusal_to_resign": {
      "purpose": "劳动者并非自愿离职时，明确拒绝签署“个人原因”辞职文件。",
      "source_anchors": [
        "LCL-2012#art37",
        "LCL-2012#art38",
        "LCL-2012#art46"
      ]
    },
    "employer_breach_record_request": {
      "purpose": "请用人单位书面确认工资、社保、降薪、调岗、停卡停工或其他相关事实。",
