        "LCL-2012#art30",
        "LCL-2012#art38",
        "SPC-LDI-1-2020#art45",
        "SPC-LDI-2-2025#art19"
      ]
    },
    "request_written_reason": {
      "purpose": "要求提供准确的书面解除或终止理由、依据、日期、工会程序情况和证明文件表述。",
      "source_anchors": [
        "LCL-2012#art39",
        "LCL-2012#art40",
        "LCL-2012#art43",
        "SPC-LDI-1-2020#art44"
      ]
    },
    "request_economic_layoff_report_package": {
      "purpose": "要求提供经济性裁员理由、提前 30 日说明及听取意见记录、向劳动行政部门报告的凭证、最终裁员方案和补偿计算依据；案件在广州时，还应要求提供当地人社部门的书面报告材料。",
      "source_anchors": [
        "LCL-2012#art41",
        "LCL-2012#art43",
        "LCL-2012#art46",
        "LDA-2007#art6"
      ]
    },
    "request_rehire_priority_and_replacement_records": {
      "purpose": "请用人单位确认经济性裁员后 6 个月内是否通过招聘、外包、劳务派遣等方式补充实质相同岗位；符合法定情形时，要求其通知被裁减人员在同等条件下享有优先招用权。",
      "source_anchors": [
        "LCL-2012#art41",
        "LDA-2007#art6"
      ]
    },
    "work_availability": {
      "purpose": "解除或终止状态不明时，说明劳动者仍可正常提供劳动或依法办理交接。",
      "source_anchors": [
        "LCL-2012#art48",
        "LCL-2012#art50"
      ]
    },
    "itemized_payment_request": {
      "purpose": "要求分项列明工资、奖金、报销、未休年休假工资、经济补偿和付款期限。",
